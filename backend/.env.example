# ProValuer backend configuration — copy to .env and fill in.
# Never commit the real .env (it is git-ignored).

# --- Database ---
# Postgres DSN. In production use sslmode=require.
# If unset, the app falls back to a localhost default (dev only).
DATABASE_URL=host=localhost user=postgres password=postgres dbname=provaluer port=5432 sslmode=disable

# --- Secrets (required — the server refuses to start if these are empty) ---
# JWT signing secret for user auth.        Generate: openssl rand -base64 32
JWT_SECRET=
# AES key for encrypting stored secrets.   Generate: openssl rand -hex 16   (32 bytes)
# WARNING: rotating this makes previously-encrypted data undecryptable.
AES_SECRET_KEY=

# --- Server ---
# API port (default 8080 if unset).
PORT=8080

# Public URL of the deployed frontend, used in verification-email links and the
# post-verification redirect. MUST be set in production or emails point at localhost.
# e.g. https://provaluer.vercel.app
APP_URL=http://localhost:3000

# --- Email (SMTP) ---
# Set to true to log emails instead of sending them (recommended in dev/staging).
SMTP_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
