# ProValuer backend configuration — copy to .env and fill in.
# Never commit the real .env (it is git-ignored).

# --- Database ---
# Postgres DSN. In production use sslmode=require.
# If unset, the app falls back to a localhost default (dev only).
DATABASE_URL=host=localhost user=postgres password=postgres dbname=provaluer port=5432 sslmode=disable

# --- Secrets (required — the server refuses to start if these are empty) ---
# JWT signing secret for user auth.        Generate: openssl rand -base64 32
JWT_SECRET=
# AES key for encrypting stored secrets.   Generate: openssl rand -hex 16   (32 bytes)
# WARNING: rotating this makes previously-encrypted data undecryptable.
AES_SECRET_KEY=

# --- Server ---
# API port (default 8080 if unset).
PORT=8080

# --- Rate limiting ---
# Number of trusted reverse proxies in front of this server. Render adds exactly
# one load balancer, so 1 is correct there. Set to 0 if the server is exposed
# directly, which makes X-Forwarded-For be ignored (it is client-supplied and
# spoofable when there is no trusted proxy to overwrite it).
TRUSTED_PROXY_HOPS=1

# --- Database logging ---
# silent | error | warn (default) | info
DB_LOG_LEVEL=warn
# Bound SQL values (passwords hashes, tokens) are replaced with $1/$2 placeholders
# by default. Set to true ONLY for local debugging — never on a deployed environment.
DB_LOG_PARAMS=false

# Public URL of the deployed frontend, used in verification-email links and the
# post-verification redirect. MUST be set in production or emails point at localhost.
# e.g. https://provaluer.vercel.app
APP_URL=http://localhost:3000

# --- Email (Brevo transactional API) ---
# Email is sent over HTTPS via Brevo, not SMTP: Render and most PaaS hosts block
# outbound SMTP ports (25/465/587), so a direct SMTP dial times out.
#
# Anything other than "false" means mock mode — emails are logged, not sent.
# Unset defaults to mock so a misconfigured environment never mails real users.
EMAIL_MOCK=true

# From Brevo dashboard -> SMTP & API -> API Keys (create a v3 key).
BREVO_API_KEY=
# Must be an address verified in Brevo, or the API rejects the send with a 400.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Provaluer
